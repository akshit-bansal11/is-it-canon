{
  "name": "isitcanon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "imports": "biome check --write --linter-enabled=false .",
    "lint:js": "biome lint . && eslint . --max-warnings=0",
    "lint:js:fix": "biome lint --write . && eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format && npm run lint:js && npm run lint:css && npm run typecheck && npm run test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@next/eslint-plugin-next": "^16.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
