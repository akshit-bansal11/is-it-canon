{
  "name": "isitcanon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "imports": "biome check --write --linter-enabled=false .",
    "lint:js": "biome lint . && eslint . --max-warnings=0",
    "lint:js:fix": "biome lint --write . && eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format && npm run imports && npm run lint:js && npm run lint:css && npm run typecheck && npm run data:check && npm run test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "data:enrich": "node --env-file=.env.local scripts/enrich-data.mjs",
    "data:audit": "node --env-file=.env.local scripts/audit-coverage.mjs",
    "data:check": "node scripts/check-data.mjs",
    "check:ci": "biome ci . && eslint . --max-warnings=0 && npm run lint:css && npm run typecheck && npm run data:check && npm run test",
    "data:seed": "node --env-file=.env.local scripts/seed-db.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.73.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.12",
    "posthog-js": "^1.428.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.8",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.6",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
