# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
.next/
out/

# production
build/
dist/

# testing
coverage/
test-results/
playwright-report/
blob-report/

# convex
.convex/

# env files (can opt-in for committing if needed)
.env.local
.env.ide
.env.prod

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ide / agents
.vscode/
.gemini/
.kiro/
# Track the project rules so they survive a fresh clone; keep everything else
# in .claude/ local — settings.json holds machine-specific config and secrets.
.claude/*
!.claude/CLAUDE.md

# scratch/notes
MEMORY_*.md
PLAN_*.md
backup/

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
.DS_Store
*.pem

# local
.temp/
.backup/
apps/app/src/assets/original
.env*

!.env.example

# data enrichment cache
scripts/.cache/
