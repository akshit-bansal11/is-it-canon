# --- Neon (Postgres) --------------------------------------------------------
# The canon and screen datasets. Copy the pooled connection string from the Neon
# dashboard. Server-side only: it is never NEXT_PUBLIC_ and must never reach the
# browser. `npm run data:seed` reads it to create the tables and load the
# authored JSON.
DATABASE_URL=

# --- Better Stack (observability) -------------------------------------------
# Wired but inert until set: a missing token means "not reporting", never a
# crash or failed calls from a visitor's browser.
#
# The errors token is a public application token — it says where reports go and
# grants nothing, which is why it may ship in the page. The source token is for
# Telemetry (logs), read by @logtail/next through the next.config wrapper.
NEXT_PUBLIC_BETTER_STACK_ERRORS_TOKEN=
NEXT_PUBLIC_BETTER_STACK_SOURCE_TOKEN=
NEXT_PUBLIC_BETTER_STACK_INGESTING_URL=

# Web analytics needs no variable at all. Vercel Web Analytics is enabled by the
# platform, has no key, and is readable through the Vercel API — which is the
# whole reason it replaced a dashboard-gated analytics key here.

# --- IsThereAnyDeal ---------------------------------------------------------
# Powers the "Update prices" button and scripts/enrich-data.mjs.
# Create one at https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# --- IGDB (via Twitch) ------------------------------------------------------
# Used by scripts/enrich-data.mjs to pull release years, ratings and runtimes.
# Register an app at https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
