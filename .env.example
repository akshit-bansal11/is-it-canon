# --- Convex -----------------------------------------------------------------
# Written automatically by `npx convex dev`; do not hand-edit the local copy.
# NEXT_PUBLIC_CONVEX_URL is public by design — it ships in the client bundle,
# which is exactly why every function that changes data is an internalMutation
# rather than a public one.
# On Vercel, set NEXT_PUBLIC_CONVEX_URL and a CONVEX_DEPLOY_KEY generated from
# the Convex dashboard. CONVEX_DEPLOYMENT is local-only and is not needed there.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- IsThereAnyDeal ---------------------------------------------------------
# Powers the "Update prices" button and scripts/enrich-data.mjs.
# Create one at https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# --- IGDB (via Twitch) ------------------------------------------------------
# Used by scripts/enrich-data.mjs to pull release years, ratings and runtimes.
# Register an app at https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
