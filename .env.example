# --- Convex -----------------------------------------------------------------
# Written automatically by `npx convex dev`; do not hand-edit the local copy.
# NEXT_PUBLIC_CONVEX_URL is public by design — it ships in the client bundle,
# which is exactly why every function that changes data is an internalMutation
# rather than a public one.
# On Vercel, set NEXT_PUBLIC_CONVEX_URL and a CONVEX_DEPLOY_KEY generated from
# the Convex dashboard. CONVEX_DEPLOYMENT is local-only and is not needed there.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Observability (Tier 0) -------------------------------------------------
# Both are wired and inert until their key is set: no key means "not
# reporting", never a crash or a stream of failed calls from every visitor.
# NEXT_PUBLIC_SENTRY_DSN is safe to expose; it is a write-only ingest endpoint.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Build-time only, for uploading source maps. Without these the Sentry wrapper
# is a no-op and stack traces stay minified, which makes the integration
# useless rather than merely quiet. Never expose SENTRY_AUTH_TOKEN.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- IsThereAnyDeal ---------------------------------------------------------
# Powers the "Update prices" button and scripts/enrich-data.mjs.
# Create one at https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# --- IGDB (via Twitch) ------------------------------------------------------
# Used by scripts/enrich-data.mjs to pull release years, ratings and runtimes.
# Register an app at https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
